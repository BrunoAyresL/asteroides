    41                                  atualizar_nave:
    42 00000050 E8(0000)                		CALL	checar_colisao						; checa a colisão entre asteroide - nave
    43 00000053 E8(0000)                		CALL    render_nave							; calcula a posição e desenha a nave
    44 00000056 C3                      		RET
    45                                  
    46                                  atualizar_asteroides:
    47 00000057 50                      		PUSH 	AX									; salva contexto
    48 00000058 FF06[0200]              		INC 	word [ast_contador_spawn]			; incrementa o contador de spawn
    49 0000005C A1[0000]                		MOV		AX, word [ast_tempo_spawn]	
    50 0000005F 3906[0200]              		CMP 	word [ast_contador_spawn], AX		; compara com o tempo definido pela dificuldade
    51 00000063 7508                    		JNE 	atualizar_asteroides_fim
    52 00000065 C606[0200]00            		MOV		byte [ast_contador_spawn], 0	
    53 0000006A E8(0000)                		CALL 	spawn_asteroide						; spawna 1 asteroide
    54                                  atualizar_asteroides_fim:
    55 0000006D E8(0000)                		CALL 	render_asteroide					; calcula a posição e desenha os asteroides
    56 00000070 58                      		POP 	AX									; recupera contexto
    57 00000071 C3                      		RET
