    11                                  processar_entrada:								; interpreta a saída do teclado para o jogo
    12 00000000 F706[0000][0000]                TEST    word [teclas], tecla_w			; tecla W move a nave para frente
    13 00000006 7405                            JZ      checar_a
    14 00000008 C606[0000]01                    MOV     byte [nave_movendo], 1
    15                                  checar_a:
    16 0000000D F706[0000][0000]                TEST    word [teclas], tecla_a			; tecla A gira a nave para a esquerda
    17 00000013 7405                            JZ      checar_s
    18 00000015 8006[0000]07                    ADD		byte [nave_angulo], 7
    19                                  checar_s:
    20 0000001A F706[0000][0000]                TEST    word [teclas], tecla_s			; tecla S move a nave para trás
    21 00000020 740A                            JZ      checar_d
    22 00000022 C606[0000]01                    MOV     byte [nave_movendo], 1
    23 00000027 C606[0000]01            		MOV		byte [nave_tras], 1
    24                                  checar_d:
    25 0000002C F706[0000][0000]                TEST    word [teclas], tecla_d			; tecla D gira a nave para a direita
    26 00000032 7405                            JZ      checar_p
    27 00000034 802E[0000]07                    SUB     byte [nave_angulo], 7
    28                                  checar_p:
    29 00000039 F706[0000][0000]        		TEST	word [teclas], tecla_p			; tecla P pausa o jogo
    30 0000003F 740E                    		JZ		fim_entrada
    31 00000041 C606[0000]04            		MOV		byte [estado_atual], 4
    32 00000046 B8[0000]                		MOV 	AX, tecla_p
    33 00000049 F7D0                    		NOT 	AX
    34 0000004B 2106[0000]              		AND		word [teclas], AX
    35                                  
    36                                  fim_entrada:
    37 0000004F C3                      		RET
